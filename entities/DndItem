{
  "name": "DndItem",
  "type": "object",
  "properties": {
    "name": {"type": "string", "description": "Item name"},
    "category": {"type": "string", "enum": ["Race", "Subrace", "Class", "Subclass", "Background", "Feat", "Spell", "Weapon", "Armor", "Adventuring Gear", "Tool", "Mount & Vehicle", "Magic Item", "Language", "Skill", "Condition", "Sense", "Currency"], "description": "Item category per D&D 5e"},
    "source": {"type": "string", "enum": ["PHB", "XGE", "TCE", "MToF", "VGM", "DMG", "SCAG", "GGR", "EGW", "FToD", "SJA", "Custom"], "default": "PHB", "description": "Source book"},
    "approval_status": {"type": "string", "enum": ["draft", "pending", "approved", "rejected"], "default": "draft"},
    "visibility": {"type": "string", "enum": ["public", "private", "group"], "default": "private"},
    "tags": {"type": "array", "items": {"type": "string"}},
    "version_history": {"type": "array", "items": {"type": "object"}},
    "description": {"type": "string", "description": "Rich text description (HTML)"},
    "short_description": {"type": "string", "description": "Brief tooltip summary"},
    "effects": {"type": "array", "items": {"type": "object"}},
    "prerequisites": {"type": "array", "items": {"type": "object"}},
    "sub_items": {"type": "array", "items": {"type": "string"}},
    "parent_item_id": {"type": "string", "description": "ID of the parent item if this is a sub-item"},
    "is_active": {"type": "boolean", "default": true},
    "spell_level": {"type": "number", "description": "Spell level (0 = cantrip), only for spells"},
    "spell_school": {"type": "string", "description": "School of magic, only for spells"},
    "casting_time": {"type": "string"},
    "range_imperial": {"type": "string", "description": "Range in original imperial units (auto-converted on display)"},
    "duration": {"type": "string"},
    "components": {"type": "string", "description": "V, S, M components"},
    "damage_dice": {"type": "string"},
    "damage_type": {"type": "string"},
    "weight_lbs": {"type": "number", "description": "Weight in lbs (auto-converted to kg on display)"},
    "cost_gp": {"type": "number", "description": "Cost in gold pieces"},
    "armor_class": {"type": "number"},
    "armor_type": {"type": "string", "enum": ["light", "medium", "heavy", "shield", ""]},
    "stealth_disadvantage": {"type": "boolean"},
    "str_requirement": {"type": "number"},
    "hit_die": {"type": "string", "description": "e.g. d8, d10 — for classes"},
    "class_spell_list": {"type": "string", "description": "Class that gets this spell"},
    "available_classes": {"type": "array", "items": {"type": "string"}}
  },
  "required": ["name", "category"]
}