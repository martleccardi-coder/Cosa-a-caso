{
  "name": "CharacterSheet",
  "type": "object",
  "properties": {
    "character_name": {"type": "string"},
    "player_name": {"type": "string"},
    "owner_user_id": {"type": "string", "description": "Base44 User ID of the sheet owner"},
    "class_id": {"type": "string", "description": "DndItem ID of the chosen class"},
    "subclass_id": {"type": "string"},
    "level": {"type": "number", "default": 1},
    "background_id": {"type": "string"},
    "race_id": {"type": "string"},
    "subrace_id": {"type": "string"},
    "alignment": {"type": "string"},
    "experience_points": {"type": "number", "default": 0},
    "visibility": {"type": "string", "enum": ["public", "private", "group"], "default": "private"},
    "tags": {"type": "array", "items": {"type": "string"}},
    "role_marker": {"type": "string"},
    "favorite": {"type": "boolean", "default": false},
    "notes": {"type": "string"},
    "version_history": {"type": "array", "items": {"type": "object"}},
    "ability_scores": {"type": "object", "properties": {"STR": {"type": "number", "default": 10}, "DEX": {"type": "number", "default": 10}, "CON": {"type": "number", "default": 10}, "INT": {"type": "number", "default": 10}, "WIS": {"type": "number", "default": 10}, "CHA": {"type": "number", "default": 10}}},
    "hp_max": {"type": "number"},
    "hp_current": {"type": "number"},
    "hp_temp": {"type": "number", "default": 0},
    "hit_dice_total": {"type": "string"},
    "hit_dice_remaining": {"type": "string"},
    "death_saves": {"type": "object", "properties": {"successes": {"type": "number", "default": 0}, "failures": {"type": "number", "default": 0}}},
    "speed_override": {"type": "number", "description": "Manual override for speed (meters)"},
    "ac_override": {"type": "number"},
    "initiative_bonus": {"type": "number", "default": 0},
    "inspiration": {"type": "boolean", "default": false},
    "feat_ids": {"type": "array", "items": {"type": "string"}},
    "spell_ids": {"type": "array", "items": {"type": "string"}},
    "equipment_ids": {"type": "array", "items": {"type": "string"}},
    "inventory": {"type": "array", "items": {"type": "object"}},
    "equipped_armor_id": {"type": "string"},
    "equipped_shield": {"type": "boolean", "default": false},
    "skill_overrides": {"type": "object", "additionalProperties": {"type": "number"}},
    "saving_throw_overrides": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "attacks": {"type": "array", "items": {"type": "object"}},
    "spell_slots_used": {"type": "object", "additionalProperties": {"type": "number"}},
    "concentration_spell": {"type": "string"},
    "prepared_spells": {"type": "array", "items": {"type": "string"}},
    "resource_counters": {"type": "object", "additionalProperties": {"type": "string"}},
    "calendar_notes": {"type": "array", "items": {"type": "object"}},
    "currency": {"type": "object", "properties": {"cp": {"type": "number", "default": 0}, "sp": {"type": "number", "default": 0}, "ep": {"type": "number", "default": 0}, "gp": {"type": "number", "default": 0}, "pp": {"type": "number", "default": 0}}},
    "personality_traits": {"type": "string"},
    "ideals": {"type": "string"},
    "bonds": {"type": "string"},
    "flaws": {"type": "string"},
    "backstory": {"type": "string"},
    "allies_and_organizations": {"type": "string"},
    "treasure_notes": {"type": "string"},
    "appearance": {"type": "object"},
    "extra_languages": {"type": "array", "items": {"type": "string"}},
    "extra_proficiencies": {"type": "array", "items": {"type": "string"}},
    "last_saved": {"type": "string", "format": "date-time"},
    "is_cloud_saved": {"type": "boolean", "default": false},
    "sheet_version": {"type": "string", "default": "1.0"}
  },
  "required": ["character_name"]
}